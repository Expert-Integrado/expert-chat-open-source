{
  "manifest_version": 3,
  "name": "Expert Chat - painel dos seus apps de comunicação",
  "version": "1.0.0",
  "description": "Abre o seu painel do Expert Chat (open source, auto-hospedado) no painel lateral do Chrome, ao lado de qualquer site.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir o atendimento",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
